# Origami Kernel — Образец переменных окружения (.env.example)
# Скопируйте этот файл в .env (или задайте переменные в системе/IDE).
# Файл .env добавлен в .gitignore и НИКОГДА не должен попадать в репозиторий.

# ==============================================================================
# 1. Авторизация информационной базы 1С
# ==============================================================================
# Пароль пользователя ИБ (по умолчанию для пользователя из origami.config.json)
ORIGAMI_DB_PASSWORD=

# ==============================================================================
# 2. Универсальный LLM / Консилиум Архитекторов (OpenAI-compatible)
# ==============================================================================
# Поддерживается любой OpenAI-совместимый провайдер:
# OmniRoute, LM Studio, Ollama, OpenRouter, DeepSeek, Groq, OpenAI и т.д.

# Единый ключ доступа (проверяется в первую очередь)
ORIGAMI_LLM_KEY=

# Точка подключения (если отличается от http://localhost:20128/v1)
# Примеры:
# - OmniRoute локальный:     http://localhost:20128/v1
# - LM Studio локальный:    http://localhost:1234/v1
# - Ollama локальный:       http://localhost:11434/v1
# - OpenRouter:             https://openrouter.ai/api/v1
# - DeepSeek:               https://api.deepseek.com/v1
# - OpenAI прямой:          https://api.openai.com/v1
OPENAI_BASE_URL=http://localhost:20128/v1

# Стандартные ключи внешних провайдеров (автоматически подхватываются при наличии)
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-v1-...
# DEEPSEEK_API_KEY=sk-...

# ==============================================================================
# 3. Специальные ключи для OmniRoute / OpenCode (опционально)
# ==============================================================================
# OMNIROUTE_API_KEY=
# OMNIROUTE_ADMIN_KEY=
