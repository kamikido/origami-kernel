// 2. Дефект DeprecatedError (Стандарт БСП): устаревший вызов ПодробноеПредставлениеОшибки
Процедура ВыполнитьОбработкуИсключения(ИнформацияОбОшибке)
	ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
КонецПроцедуры

// 3. Дефекты UsingOrInWhere (Стандарт 658) и UnionWithoutAll (Стандарт 434) в тексте запроса
Функция ПолучитьДанныеЗапросом()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ПометкаУдаления ИЛИ Номенклатура.ЭтоГруппа
		|ОБЪЕДИНИТЬ
		|ВЫБРАТЬ
		|	Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Склады КАК Склады";
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// 4. Дефект MissingElse (Строгий режим надежности): ветка Если-ИначеЕсли без блока Иначе
Процедура ПроверитьВетвление(Значение)
	Если Значение = 1 Тогда
		Сообщить("Один");
	ИначеЕсли Значение = 2 Тогда
		Сообщить("Два");
	КонецЕсли;
КонецПроцедуры

// 5. Дефект CognitiveComplexity (Стандарты разработки 1С): глубина вложенности блоков >= 5
Процедура ПроверитьГлубокуюВложенность()
	Если Истина Тогда
		Для Счетчик = 1 По 10 Цикл
			Пока Счетчик > 0 Цикл
				Попытка
					Если Счетчик = 5 Тогда
						Сообщить("Вложенность 5 уровней достигнута");
					КонецЕсли;
				Исключение
					ВызватьИсключение;
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
