#Использовать "./Классы"

// ==============================================================================
// format_bsl.os — Универсальная CLI-утилита форматирования BSL-кода (OneStyle / SmartConfigurator / АПК).
//
// Возможности:
// 1. Автоперенос строк свыше 120 символов по параметрам.
// 2. Канонический регистр операторов BSL (Для Каждого, Если ... Тогда, КонецЦикла).
// 3. Верхний регистр ключевых слов языка запросов (ВЫБРАТЬ, ИЗ, ГДЕ, КАК, ЛЕВОЕ СОЕДИНЕНИЕ).
// 4. Колоночное выравнивание знаков "=" и параметров по запятым.
// 5. Умный режим --diff: форматирует только доработанные блоки, не замусоривая типовой код.
//
// Поддерживаемые маркеры доработок:
// - Семейство плюс/минус:  // + ... // -  (например: // + ЛС ..., // +++, // + Иванов)
// - Семейство стрелок:     // <-- ... // -->  (например: // <--BNM:, // <---)
// - Семейство скобок:      // { ... // }
// - Платформенные вставки: #Вставка ... #КонецВставки
// - Кастомные маркеры из tools/1c-project.json или CLI-аргументов (--start, --end)
// ==============================================================================

#Область СлужебныеПроцедурыИФункции

Функция ЗагрузитьНастройкиПроекта(Знач КаталогФайла)
	
	Кастомные = Новый Структура("startMarker,endMarker,maxLineLength", "", "", 120);
	
	// Ищем 1c-project.json в текущем каталоге и родительских папках
	ТекКаталог = КаталогФайла;
	Для Шаг = 1 По 5 Цикл
		Если ПустаяСтрока(ТекКаталог) Тогда
			Прервать;
		КонецЕсли;
		
		ПутиДляПроверки = Новый Массив;
		ПутиДляПроверки.Добавить(ОбъединитьПути(ТекКаталог, "origami.config.json"));
		
		Для Каждого Канд Из ПутиДляПроверки Цикл
			ФайлКонфиг = Новый Файл(Канд);
			Если ФайлКонфиг.Существует() Тогда
				Попытка
					Чтение = Новый ЧтениеJSON();
					Чтение.ОткрытьФайл(Канд);
					ДанныеJSON = ПрочитатьJSON(Чтение);
					Чтение.Закрыть();
					
					// Поддержка origami.config.json
					Если ДанныеJSON.Свойство("qualityGates") Тогда
						Врата = ДанныеJSON.qualityGates;
						Если Врата.Свойство("maxLineLength") Тогда
							Кастомные.maxLineLength = Число(Врата.maxLineLength);
						КонецЕсли;
					КонецЕсли;
					Если ДанныеJSON.Свойство("project") Тогда
						Проект = ДанныеJSON.project;
						Если Проект.Свойство("authorShort") Тогда
							Кастомные.startMarker = "// { +";
							Кастомные.endMarker = "// }";
						КонецЕсли;
					КонецЕсли;
					
					// Обратная совместимость с 1c-project.json
					Если ДанныеJSON.Свойство("codeStyle") Тогда
						Стиль = ДанныеJSON.codeStyle;
						Если Стиль.Свойство("diffStart") Тогда
							Кастомные.startMarker = СокрЛП(Стиль.diffStart);
						КонецЕсли;
						Если Стиль.Свойство("diffEnd") Тогда
							Кастомные.endMarker = СокрЛП(Стиль.diffEnd);
						КонецЕсли;
						Если Стиль.Свойство("maxLineLength") Тогда
							Кастомные.maxLineLength = Число(Стиль.maxLineLength);
						КонецЕсли;
					КонецЕсли;
				Исключение
					// Игнорируем ошибки парсинга чужого JSON
				КонецПопытки;
				Возврат Кастомные;
			КонецЕсли;
		КонецЦикла;
		
		Родитель = Новый Файл(ТекКаталог);
		ТекКаталог = Родитель.Путь;
	КонецЦикла;
	
	Возврат Кастомные;
	
КонецФункции

Функция МодельНастроек(Знач ОграничениеДлины = 120)

	Эталоны = Новый Массив;
	Эталоны.Добавить("Если");
	Эталоны.Добавить("Тогда");
	Эталоны.Добавить("Иначе");
	Эталоны.Добавить("ИначеЕсли");
	Эталоны.Добавить("КонецЕсли");
	Эталоны.Добавить("Для");
	Эталоны.Добавить("Каждого");
	Эталоны.Добавить("Цикл");
	Эталоны.Добавить("КонецЦикла");
	Эталоны.Добавить("Выполнить");
	Эталоны.Добавить("По");
	Эталоны.Добавить("Прервать");
	Эталоны.Добавить("Продолжить");
	Эталоны.Добавить("Из");
	Эталоны.Добавить("Новый");
	Эталоны.Добавить("Перейти");
	Эталоны.Добавить("Перем");
	Эталоны.Добавить("Пока");
	Эталоны.Добавить("Попытка");
	Эталоны.Добавить("Исключение");
	Эталоны.Добавить("КонецПопытки");
	Эталоны.Добавить("ВызватьИсключение");
	Эталоны.Добавить("Процедура");
	Эталоны.Добавить("КонецПроцедуры");
	Эталоны.Добавить("Функция");
	Эталоны.Добавить("КонецФункции");
	Эталоны.Добавить("Экспорт");
	Эталоны.Добавить("Возврат");
	Эталоны.Добавить("ДобавитьОбработчик");
	Эталоны.Добавить("УдалитьОбработчик");
	Эталоны.Добавить("И");
	Эталоны.Добавить("ИЛИ");
	Эталоны.Добавить("НЕ");
	Эталоны.Добавить("Или");
	Эталоны.Добавить("Не");

	Настройки = Новый Соответствие();
	Настройки.Вставить("ОграничениеДлиныСтроки", ОграничениеДлины);
	Настройки.Вставить("СдвигПревышение", 50);
	Настройки.Вставить("ДобавлятьПробелыВнутриСкобок", Ложь);
	Настройки.Вставить("ДобавлятьПустыеСтрокиПередКомментарием", Ложь);
	Настройки.Вставить("ДобавлятьПустыеСтрокиВокругКлючевыхКонструкций", Истина);
	Настройки.Вставить("МаксПустыхСтрок", 1);
	Настройки.Вставить("ВыравниватьПоРавно", Истина);
	Настройки.Вставить("ВыравниватьПоСкобке", Ложь);
	Настройки.Вставить("ВыравниватьПоЗапятой", Истина);
	Настройки.Вставить("ВыравниватьПоКомментариям", Истина);
	Настройки.Вставить("РежимВыравниванияТекстов", 0);
	Настройки.Вставить("Эталоны", Эталоны);

	Возврат Настройки;

КонецФункции

Функция ЭтоНачалоБлока(Знач Стр, Знач КастомныйСтарт)
	
	СтрТрим = СокрЛ(Стр);
	Если Не ПустаяСтрока(КастомныйСтарт) И СтрНачинаетсяС(СтрТрим, КастомныйСтарт) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрНачинаетсяС(СтрТрим, "// +") 
	   Или СтрНачинаетсяС(СтрТрим, "//+")
	   Или СтрНачинаетсяС(СтрТрим, "// <--")
	   Или СтрНачинаетсяС(СтрТрим, "//<--")
	   Или СтрНачинаетсяС(СтрТрим, "// {")
	   Или СтрНачинаетсяС(СтрТрим, "//#Вставка")
	   Или СтрНачинаетсяС(СтрТрим, "#Вставка") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоКонецБлока(Знач Стр, Знач КастомныйКонец)
	
	СтрТрим = СокрЛ(Стр);
	Если Не ПустаяСтрока(КастомныйКонец) И СтрНачинаетсяС(СтрТрим, КастомныйКонец) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрНачинаетсяС(СтрТрим, "// -") 
	   Или СтрНачинаетсяС(СтрТрим, "//-")
	   Или СтрНачинаетсяС(СтрТрим, "// -->")
	   Или СтрНачинаетсяС(СтрТрим, "//-->")
	   Или СтрНачинаетсяС(СтрТрим, "// }")
	   Или СтрНачинаетсяС(СтрТрим, "//#КонецВставки")
	   Или СтрНачинаетсяС(СтрТрим, "#КонецВставки") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ФорматироватьТекст(Знач ИсходныйТекст, Знач Настройки)

	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	ТекстовыйДокумент.УстановитьТекст(ИсходныйТекст);

	Попытка
		APK.Форматировать(ТекстовыйДокумент, Настройки);
		Выравниватель.ВыровнитьКод(ТекстовыйДокумент, Настройки);
	Исключение
		Сообщить("[Ошибка форматирования]: " + ОписаниеОшибки());
	КонецПопытки;

	Возврат ТекстовыйДокумент.ПолучитьТекст();

КонецФункции

Функция ФорматироватьФрагментыDiff(Знач ПолныйТекст, Знач Настройки, Знач КастомныйСтарт, Знач КастомныйКонец, КоличествоБлоков)

	ТекDoc = Новый ТекстовыйДокумент();
	ТекDoc.УстановитьТекст(ПолныйТекст);
	
	ВнутриБлока = Ложь;
	БлокТекст = "";
	РезультатDoc = Новый ТекстовыйДокумент();
	КоличествоБлоков = 0;
	
	Количество = ТекDoc.КоличествоСтрок();
	Для НомерСтроки = 1 По Количество Цикл
		Стр = ТекDoc.ПолучитьСтроку(НомерСтроки);
		
		Если ЭтоНачалоБлока(Стр, КастомныйСтарт) Тогда
			ВнутриБлока = Истина;
			КоличествоБлоков = КоличествоБлоков + 1;
			РезультатDoc.ДобавитьСтроку(Стр);
			БлокТекст = "";
		ИначеЕсли ЭтоКонецБлока(Стр, КастомныйКонец) И ВнутриБлока Тогда
			ВнутриБлока = Ложь;
			Если Не ПустаяСтрока(СокрЛП(БлокТекст)) Тогда
				ОтформатированныйБлок = ФорматироватьТекст(БлокТекст, Настройки);
				БлокDoc = Новый ТекстовыйДокумент();
				БлокDoc.УстановитьТекст(ОтформатированныйБлок);
				Для НомерБлока = 1 По БлокDoc.КоличествоСтрок() Цикл
					РезультатDoc.ДобавитьСтроку(БлокDoc.ПолучитьСтроку(НомерБлока));
				КонецЦикла;
			КонецЕсли;
			БлокТекст = "";
			РезультатDoc.ДобавитьСтроку(Стр);
		ИначеЕсли ВнутриБлока Тогда
			БлокТекст = БлокТекст + Стр + Символы.ПС;
		Иначе
			РезультатDoc.ДобавитьСтроку(Стр);
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатDoc.ПолучитьТекст();

КонецФункции

#КонецОбласти

// === Главная процедура CLI ===

Если АргументыКоманднойСтроки.Количество() = 0 Тогда
	Сообщить("Использование: oscript format_bsl.os <файл> [опции]");
	Сообщить("Опции:");
	Сообщить("  --diff            Форматировать только доработанные блоки (// +, // <--, // {, #Вставка)");
	Сообщить("  --all             Принудительно форматировать весь файл целиком");
	Сообщить("  --check           Проверка без изменения файла (exit code 1 если нужен формат)");
	Сообщить("  --len=120         Максимальная длина строки (по умолчанию: 120)");
	Сообщить("  --start=МЕТКА     Кастомная начальная метка доработки");
	Сообщить("  --end=МЕТКА       Кастомная конечная метка доработки");
	ЗавершитьРаботу(0);
КонецЕсли;

ПутьКФайлу = "";
ЯвныйDiff = Ложь;
ЯвныйAll = Ложь;
РежимCheck = Ложь;
МаксДлина = 0;
КастомСтарт = "";
КастомКонец = "";

Для Каждого Арг Из АргументыКоманднойСтроки Цикл
	Если Арг = "--diff" Или Арг = "-d" Тогда
		ЯвныйDiff = Истина;
	ИначеЕсли Арг = "--all" Или Арг = "-a" Тогда
		ЯвныйAll = Истина;
	ИначеЕсли Арг = "--check" Или Арг = "-c" Тогда
		РежимCheck = Истина;
	ИначеЕсли СтрНачинаетсяС(Арг, "--len=") Тогда
		МаксДлина = Число(Сред(Арг, 7));
	ИначеЕсли СтрНачинаетсяС(Арг, "--start=") Тогда
		КастомСтарт = Сред(Арг, 9);
	ИначеЕсли СтрНачинаетсяС(Арг, "--end=") Тогда
		КастомКонец = Сред(Арг, 7);
	ИначеЕсли ПустаяСтрока(ПутьКФайлу) И Не СтрНачинаетсяС(Арг, "-") Тогда
		ПутьКФайлу = Арг;
	КонецЕсли;
КонецЦикла;

Файл = Новый Файл(ПутьКФайлу);
Если Не Файл.Существует() Тогда
	Сообщить("[!!] Файл не найден: " + ПутьКФайлу);
	ЗавершитьРаботу(2);
КонецЕсли;

// Подтягиваем настройки проекта из 1c-project.json, если они не заданы в CLI
НастройкиПроекта = ЗагрузитьНастройкиПроекта(Файл.Путь);
Если МаксДлина = 0 Тогда
	МаксДлина = НастройкиПроекта.maxLineLength;
КонецЕсли;
Если ПустаяСтрока(КастомСтарт) Тогда
	КастомСтарт = НастройкиПроекта.startMarker;
КонецЕсли;
Если ПустаяСтрока(КастомКонец) Тогда
	КастомКонец = НастройкиПроекта.endMarker;
КонецЕсли;

Док = Новый ТекстовыйДокумент();
Док.Прочитать(ПутьКФайлу);
ИсходныйТекст = Док.ПолучитьТекст();

Настройки = МодельНастроек(МаксДлина);

// Выбор стратегии:
// Если указан --all -> форматируем весь файл.
// Иначе пробуем --diff: если блоки доработок найдены -> форматируем их.
// Если блоков не найдено и это небольшой файл (< 200 строк) или не указан явный --diff -> форматируем целиком.

ИтоговыйТекст = ИсходныйТекст;
КоличествоБлоков = 0;

Если ЯвныйAll Тогда
	ИтоговыйТекст = ФорматироватьТекст(ИсходныйТекст, Настройки);
Иначе
	ТекстDiff = ФорматироватьФрагментыDiff(ИсходныйТекст, Настройки, КастомСтарт, КастомКонец, КоличествоБлоков);
	Если КоличествоБлоков > 0 Тогда
		ИтоговыйТекст = ТекстDiff;
	ИначеЕсли ЯвныйDiff Тогда
		// Пользователь явно попросил diff, но маркеров нет
		Сообщить("  [i] Маркеры доработок не обнаружены в: " + ПутьКФайлу);
		ЗавершитьРаботу(0);
	Иначе
		// Маркеров нет и явного diff не просили -> форматируем весь файл
		ИтоговыйТекст = ФорматироватьТекст(ИсходныйТекст, Настройки);
	КонецЕсли;
КонецЕсли;

Если ИсходныйТекст = ИтоговыйТекст Тогда
	Сообщить("  [ok] Форматирование не требуется: " + ПутьКФайлу);
	ЗавершитьРаботу(0);
КонецЕсли;

Если РежимCheck Тогда
	Сообщить("  [!!] Требуется форматирование: " + ПутьКФайлу);
	ЗавершитьРаботу(1);
Иначе
	Док.УстановитьТекст(ИтоговыйТекст);
	Док.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
	Сообщить("  [ok] Отформатирован: " + ПутьКФайлу);
	ЗавершитьРаботу(0);
КонецЕсли;
