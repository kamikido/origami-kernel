// tools/query.os — Быстрое выполнение произвольного запроса 1С через COM-соединитель
#Использовать json

Если АргументыКоманднойСтроки.Количество() < 1 Тогда
	Сообщить("Укажите текст запроса. Пример: oscript tools/query.os ""ВЫБРАТЬ 1 КАК Тест""");
	ЗавершитьРаботу(1);
КонецЕсли;

ТекстЗапроса = АргументыКоманднойСтроки[0];

// Читаем origami.config.json
КаталогПроекта = СтрЗаменить(ТекущийСценарий().Каталог, "\tools", "");
КаталогПроекта = СтрЗаменить(КаталогПроекта, "/tools", "");
ПутьКонфиг = ОбъединитьПути(КаталогПроекта, "origami.config.json");

Если Не (Новый Файл(ПутьКонфиг)).Существует() Тогда
	Сообщить("Файл конфигурации не найден: " + ПутьКонфиг);
	ЗавершитьРаботу(2);
КонецЕсли;

Чтение = Новый ЧтениеJSON();
Чтение.ОткрытьФайл(ПутьКонфиг);
Конфиг = ПрочитатьJSON(Чтение);
Чтение.Закрыть();

ТипБазы = ВРег(Конфиг.infobase.type);
ПутьБазы = Конфиг.infobase.path;
Пользователь = Конфиг.infobase.user;
Пароль = ПолучитьПеременнуюСреды("ORIGAMI_DB_PASSWORD");
Если Пароль = Неопределено Тогда
	Пароль = "";
КонецЕсли;

Если ТипБазы = "FILE" Тогда
	СтрокаПодключения = "File=""" + ПутьБазы + """;Usr=""" + Пользователь + """;Pwd=""" + Пароль + """;";
Иначе
	Сервер = Конфиг.infobase.server;
	Части = СтрРазделить(Сервер, "\");
	СтрокаПодключения = "Srvr=""" + Части[0] + """;Ref=""" + Части[1] + """;Usr=""" + Пользователь + """;Pwd=""" + Пароль + """;";
КонецЕсли;

Попытка
	Коннектор = Новый COMОбъект("V83.COMConnector");
	База = Коннектор.Connect(СтрокаПодключения);
Исключение
	Сообщить("Ошибка подключения к 1С через COM: " + ОписаниеОшибки());
	ЗавершитьРаботу(3);
КонецПопытки;

Попытка
	Запрос = База.NewObject("Запрос");
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		Количество = Количество + 1;
		Если Количество > 25 Тогда
			Сообщить("... [Вывод ограничен 25 строками]");
			Прервать;
		КонецЕсли;
		
		СтрокаВывода = "";
		Для Инд = 0 По Результат.Колонки.Количество() - 1 Цикл
			Колонка = Результат.Колонки.Получить(Инд).Имя;
			Значение = Строка(Выборка[Колонка]);
			СтрокаВывода = СтрокаВывода + Колонка + " = " + Значение + " | ";
		КонецЦикла;
		Сообщить("  " + СтрокаВывода);
	КонецЦикла;
	
	Если Количество = 0 Тогда
		Сообщить("  [Запрос выполнен успешно, результат пуст]");
	Иначе
		Сообщить("Строк выбрано: " + Количество);
	КонецЕсли;
Исключение
	Сообщить("Ошибка выполнения запроса: " + ОписаниеОшибки());
	ЗавершитьРаботу(4);
КонецПопытки;
